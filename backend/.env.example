PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/problempulse?schema=public"
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:3000"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Admin Portal Access & Default Credentials
ADMIN_PORTAL_URL="http://localhost:3000/admin/login"
ADMIN_DEFAULT_EMAIL="admin@problempulse.gov"
ADMIN_DEFAULT_PASSWORD="admin123"
